/**
 * Tests for the App component - TypeScript
 * Comprehensive test suite covering happy path and edge cases
 */

import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import axios from 'axios';
import App from './App';

jest.mock('axios');
const mockedAxios = axios as jest.Mocked<typeof axios>;

describe('App Component - TypeScript Migration', () => {
  beforeEach(() => {
    jest.clearAllMocks();
  });

  describe('Initial Rendering', () => {
    it('should render the App without crashing', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      const { container } = render(<App />);
      expect(container.querySelector('.App')).toBeInTheDocument();
    });

    it('should display FUCK text', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'life' }],
      });

      render(<App />);
      expect(screen.getByText(/FUCK/i)).toBeInTheDocument();
    });

    it('should display Internal as default data source', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      expect(screen.getByText('Internal')).toBeInTheDocument();
    });

    it('should display dark mode as default theme', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      expect(screen.getByText(/DARK/i)).toBeInTheDocument();
    });

    it('should render loading image', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      expect(screen.getByAltText(/loading/i)).toBeInTheDocument();
    });
  });

  describe('Theme Toggle', () => {
    it('should toggle from dark to light mode', async () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      const modeButton = screen.getByText(/DARK/i).parentElement;

      fireEvent.click(modeButton!);

      await waitFor(() => {
        expect(screen.getByText(/LIGHT/i)).toBeInTheDocument();
      });
    });
  });

  describe('Data Source Toggle', () => {
    it('should toggle between Internal and Wikipedia', async () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      const sourceButton = screen.getByText('Internal').parentElement;

      mockedAxios.get.mockResolvedValueOnce({
        data: { title: 'Wikipedia' },
      });

      fireEvent.click(sourceButton!);

      await waitFor(() => {
        expect(screen.getByText('Wikipedia')).toBeInTheDocument();
      });
    });
  });

  describe('Data Fetching', () => {
    it('should call axios on mount', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      expect(mockedAxios.get).toHaveBeenCalled();
    });

    it('should fetch from internal storage', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      expect(mockedAxios.get).toHaveBeenCalledWith('storage/arraystorage.json');
    });
  });

  describe('Error Handling', () => {
    it('should handle network errors gracefully', () => {
      mockedAxios.get.mockRejectedValueOnce(new Error('Network error'));

      render(<App />);
      expect(screen.getByText(/FUCK/i)).toBeInTheDocument();
    });

    it('should handle empty data arrays', () => {
      mockedAxios.get.mockResolvedValueOnce({ data: [] });

      render(<App />);
      expect(screen.getByText(/FUCK/i)).toBeInTheDocument();
    });
  });

  describe('Component Structure', () => {
    it('should have menu container', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      const { container } = render(<App />);
      expect(container.querySelector('.App-menu')).toBeInTheDocument();
    });

    it('should have header container', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      const { container } = render(<App />);
      expect(container.querySelector('.App-header')).toBeInTheDocument();
    });

    it('should have loading container', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      const { container } = render(<App />);
      expect(container.querySelector('.App-loading')).toBeInTheDocument();
    });
  });

  describe('TypeScript Type Safety', () => {
    it('should render as typed React component', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      const component: React.ReactElement = <App />;
      render(component);
      expect(screen.getByText(/FUCK/i)).toBeInTheDocument();
    });
  });

  describe('Regression Tests', () => {
    it('should render all required elements', () => {
      mockedAxios.get.mockResolvedValueOnce({
        data: [{ string: 'test' }],
      });

      render(<App />);
      expect(screen.getByText(/FUCK/i)).toBeInTheDocument();
      expect(screen.getByText('Internal')).toBeInTheDocument();
      expect(screen.getByText(/DARK/i)).toBeInTheDocument();
      expect(screen.getByAltText(/loading/i)).toBeInTheDocument();
    });
  });
});
